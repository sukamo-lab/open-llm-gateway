# Generate long random values; never commit the real .env file.
LLM_GATEWAY_API_KEYS=
LLM_GATEWAY_ADMIN_KEY=
LLM_GATEWAY_URL=http://localhost:8000
# For horizontal scaling: postgresql://gateway:password@postgres:5432/gateway
LLM_GATEWAY_DATABASE=./data/gateway.db
# Optional exact-cache backend, for example rediss://user:password@host:6379/0
LLM_GATEWAY_REDIS_URL=
# Optional OTLP/HTTP traces endpoint, e.g. https://collector.example/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

GOOGLE_API_KEY=
OPENAI_API_KEY=

